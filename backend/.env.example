# ===================================================
# Variables de Entorno para Producción (Render + Neon)
# ===================================================

# Cadena de conexión de Neon Serverless PostgreSQL
# En Neon Console: Dashboard -> Connection Details -> Connection String (Pooled o Direct)
# Ejemplo: postgresql://neondb_owner:npg_xyz@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://usuario:clave@host-neon.tech/neondb?sslmode=require

# Puerto donde corre el servidor (Render lo inyecta automáticamente)
PORT=4000

# Entorno de ejecución
NODE_ENV=production

# Orígenes permitidos para CORS (separados por coma)
# Incluye la URL de tu frontend en producción (Render/Vercel) y Capacitor si usas app móvil
ORIGENES_PERMITIDOS=https://tu-frontend.onrender.com,https://tu-frontend.vercel.app,capacitor://localhost,https://localhost,http://localhost:5173

# Esquema de PostgreSQL (opcional, por defecto es public)
PG_SCHEMA=public
